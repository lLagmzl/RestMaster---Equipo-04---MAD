// Reglas SOLO PARA DEMOSTRACION (equivalente al "modo de prueba"): cualquiera con la config puede leer/escribir.
// Antes de usar el sistema en serio hay que agregar Firebase Authentication y reglas por rol.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
